{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "build",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["server/db-bootstrap.ts", "src/data/products.ts"],
  "exclude": ["node_modules", "dist"]
}
