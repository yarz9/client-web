{
  "name": "bioherbica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --outDir dist/client && npm run build:server && npm run build:bootstrap",
    "build:server": "tsc -p tsconfig.server.json",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json",
    "start": "node server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "npm run build:bootstrap && node build/server/db-bootstrap.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "hono": "^4.13.0",
    "lucide-react": "^1.60.0",
    "mysql2": "^3.14.0",
    "motion": "^14.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0"
  }
}
