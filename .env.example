# Copy to .env for local development, or set the same names as Railway variables.
# On Railway the simplest value is a reference to the MySQL service:
#   DATABASE_URL=${{MySQL.DATABASE_URL}}
# If only the MYSQL* parts are shared instead, the server accepts those too
# (MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE).
DATABASE_URL=mysql://user:password@host:3306/database

# /admin login. Use a unique password here; ADMIN_PASSWORD must be at least 8 characters.
ADMIN_USERNAME=bioadmin
ADMIN_PASSWORD=promijeni-ovu-lozinku

# Optional. Signs the admin session cookie. When empty or shorter than 32 characters,
# a stable key is derived from ADMIN_PASSWORD instead. Set one for best security:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
