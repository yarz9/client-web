# Copy to .env for local development, or set the same names as Railway variables.
# On Railway the simplest value is a reference to the MySQL service:
#   DATABASE_URL=${{MySQL.DATABASE_URL}}
# If only the MYSQL* parts are shared instead, the server accepts those too
# (MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE).
DATABASE_URL=mysql://user:password@host:3306/database

# /admin login. In production ADMIN_PASSWORD must be at least 12 characters and
# must not contain the placeholder word below; the server refuses a weak setup.
ADMIN_USERNAME=bioadmin
ADMIN_PASSWORD=promijeni-ovu-lozinku

# Signs the admin session cookie and the customer tracking tokens.
# Required in production, at least 32 characters; without it there is no session key.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Optional: email with a tracking code to the customer (Resend HTTP API).
# Without these two variables the panel shows a mailto: fallback instead.
RESEND_API_KEY=
ORDER_EMAIL_FROM=BioHerbica <narudzbe@example.com>

# Optional: public base URL used in tracking links inside emails.
PUBLIC_URL=https://example.com
