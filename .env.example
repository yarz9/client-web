# Copy to .env for local development, or set the same names as Railway variables.
DATABASE_URL=mysql://user:password@host:3306/database

# /admin login. Use a unique password here; ADMIN_PASSWORD must be at least 8 characters.
ADMIN_USERNAME=bioadmin
ADMIN_PASSWORD=promijeni-ovu-lozinku

# Signs the admin session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters.
ADMIN_SESSION_SECRET=
