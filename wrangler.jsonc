{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "store",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-29",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bioherbica-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "src/data/migrations"
    }
  ],
  "vars": {
    "FREEBUFF_CLIENT_ID": "44addc86-18b3-4ca3-9467-2bc7f67a0839",
    "FREEBUFF_ISSUER": "https://freebuff.com/oidc",
    "APP_ORIGIN": "http://localhost:5173"
  },
  "r2_buckets": [{ "binding": "PRODUCT_IMAGES", "bucket_name": "bioherbica-local-images" }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "placement": { "mode": "off" }
}
